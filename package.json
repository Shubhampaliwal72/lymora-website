{
  "name": "lymora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "verify:browser": "node scripts/verify-browser.mjs",
    "postbuild": "node scripts/normalize-static-segments.mjs",
    "verify:motion": "node scripts/verify-network-motion.mjs",
    "verify:export": "node scripts/verify-static-links.mjs && node scripts/verify-cloudflare-export.mjs",
    "verify:launch": "node scripts/verify-network-motion.mjs --launch-only",
    "verify:navigation": "node scripts/verify-navigation-state.mjs && node scripts/verify-network-motion.mjs --navigation-only",
    "postinstall": "node scripts/r3f-timer-compat.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@react-three/fiber": "9.8.2",
    "gsap": "3.15.1",
    "motion": "14.10.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.187.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "Independent Lymora product website, exported statically for Cloudflare Pages.",
  "engines": {
    "node": ">=22.14.0"
  }
}
